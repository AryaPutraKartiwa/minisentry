# Copy to .env and replace every value. .env is git-ignored; never commit it.
# Generate values with: openssl rand -hex 32   (hex keeps them URL-safe)

POSTGRES_PASSWORD=change-me
REDIS_PASSWORD=change-me
# project_id:key, comma-separated for more projects. The key goes in the SDK DSN:
#   http://<key>@<host>:8000/1
PROJECT_KEYS=1:change-me

# Where the API listens on the host. Use 127.0.0.1 when a reverse proxy (Caddy/nginx) handles TLS in front.
API_BIND=0.0.0.0
API_PORT=8000
